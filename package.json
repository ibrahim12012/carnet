{
  "name": "carnet",
  "productName": "Carnet",
  "version": "0.2.0",
  "description": "Video journal that works as a second brain: talk to the camera, Carnet transcribes, follows your subjects from one video to the next and keeps what you say about yourself.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "bash build-mac.sh"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.chef.carnet",
    "productName": "Carnet",
    "copyright": "Copyright © 2026 Chef",
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "shortcutName": "Carnet",
      "artifactName": "Carnet-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "build/mac-whisper",
          "to": "whisper"
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Carnet films the entries of your video journal.",
        "NSMicrophoneUsageDescription": "Carnet records your voice in the entries of your video journal.",
        "NSLocalNetworkUsageDescription": "Carnet receives the picture of your phone over your Wi-Fi when you use the phone as a camera."
      }
    },
    "dmg": {
      "artifactName": "Carnet-${version}-mac-${arch}.${ext}",
      "writeUpdateInfo": false
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mov",
          "mkv",
          "webm",
          "avi",
          "m4v"
        ],
        "name": "Video",
        "description": "Video",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "protocols": [
      {
        "name": "Carnet",
        "schemes": [
          "carnet",
          "raccord"
        ]
      }
    ]
  },
  "author": "Chef",
  "license": "GPL-3.0-or-later"
}
